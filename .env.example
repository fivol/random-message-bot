# Telegram bot token from @BotFather
BOT_API_TOKEN=

# PostgreSQL connection string
PG_URL=postgresql://postgres:postgres@localhost:5432/random_message

# Optional: crash alerts via @alarmer_bot
ALARMER_KEY=

# Optional: passphrase for the stats command
ADMIN_KEY=

# Optional: public URL when running on webhooks
HOST=

# Optional: verbose logging
DEBUG=
